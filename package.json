{
  "name": "ngx-emfular-integration",
  "version": "1.0.0",
  "description": "Integrates emfular with its ngx-helper to provide modeling services",
  "keywords": [
    "EMFular",
    "Angular",
    "Modeling"
  ],
  "author": {
    "name": "Susanne Göbel",
    "email": "goebel@uni-koblenz.de"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/softlang/EMFular-integration"
  },
  "scripts": {
    "use:local": "./scripts/local.sh",
    "use:public": "./scripts/public.sh",
    "test": "vitest --config vitest.browser.config.ts --run",
    "test:watch": "vitest --config vitest.browser.config.ts",
    "test:local": "npm run use:local && npm run test",
    "test:public": "npm run use:public && npm run test",
    "build": "ng-packagr -p ng-package.json",
    "build:local": "npm run use:local && npm run build",
    "build:public": "npm run use:public && npm run build",
    "verify:local": "npm run use:local && npm run test && npm run build",
    "verify:public": "npm run use:public && npm run test && npm run build"
  },
  "exports": {
    "./*": {
      "default": "./*"
    },
    "./public-api": {
      "default": "./public-api.js"
    },
    "./details-overlay.css": {
      "default": "./details-overlay.css"
    }
  },
  "peerDependencies": {
    "@angular/cdk": "^19.2.7",
    "@angular/common": "^19.2.7",
    "@angular/core": "^19.2.7",
    "@angular/forms": "^19.2.7",
    "@angular/material": "^19.2.7",
    "@types/uuid": "^10.0.0"
  },
  "dependencies": {
    "emfular-core": "^1.0.0",
    "ngx-emfular-diagram": "^1.0.1",
    "ngx-emfular-tool": "^1.0.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^1.19.2",
    "@angular-devkit/build-angular": "^19.2.25",
    "@angular/build": "^19.2.25",
    "@angular/compiler": "^19.2.7",
    "@angular/platform-browser": "^19.2.7",
    "@angular/platform-browser-dynamic": "^19.2.7",
    "@testing-library/dom": "^10.4.1",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "jsdom": "^29.1.1",
    "ng-packagr": "^19.2.2",
    "playwright": "^1.61.1",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "sideEffects": false
}
